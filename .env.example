# ==============================================================================
# ExamOps — Master Production Environment Variables Template
# Copy this file to .env for local development. NEVER commit actual secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Pooled connection string (port 6543) or direct connection string (port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=production
VERSION=1.0.0
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["https://examops.vercel.app","https://examops-staging.vercel.app","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=generate-a-secure-random-64-character-hex-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection Pool Tuning (per-worker settings for 4 Uvicorn workers)
# 4 workers * 4 maxconn = 16 max combined connections (preserving 4 headroom under 20-connection PgBouncer limit)
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=4

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite requires VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_BASE_URL=https://examops-backend.onrender.com/api
